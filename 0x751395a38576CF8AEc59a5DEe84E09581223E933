pragma solidity ^0.8.20;

import "https://github.com/OpenZeppelin/openzeppelin-contracts/blob/v5.0.2/contracts/token/ERC20/ERC20.sol";
import "https://github.com/OpenZeppelin/openzeppelin-contracts/blob/v5.0.2/contracts/token/ERC20/extensions/ERC20Burnable.sol";
import "https://github.com/OpenZeppelin/openzeppelin-contracts/blob/v5.0.2/contracts/access/Ownable.sol";

contract CharruaToken is ERC20, ERC20Burnable, Ownable {
    constructor(
        string memory nombre_,
        string memory simbolo_,
        uint256 suministroInicial
    ) ERC20(nombre_, simbolo_) Ownable(msg.sender) {
        _mint(msg.sender, suministroInicial * 10 ** decimals());
    }

    function mint(address cuenta, uint256 cantidad) public onlyOwner {
        _mint(cuenta, cantidad);
    }
}
